{
  "name": "labeldesk",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "LabelDesk - Windows 标签设计与热敏打印工具",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "verify:1d": "node scripts/verify-1d.mjs",
    "verify:qr": "node scripts/verify-qr.mjs",
    "verify:variables": "node --import ./scripts/loader-register.mjs scripts/verify-variables.mjs",
    "verify:fill": "node --import ./scripts/loader-register.mjs scripts/verify-fill.mjs",
    "verify:dpi": "node --import ./scripts/loader-register.mjs scripts/verify-dpi.mjs",
    "verify:history": "node --import ./scripts/loader-register.mjs scripts/verify-history.mjs",
    "verify:qrmatrix": "node --import ./scripts/loader-register.mjs scripts/verify-qr-matrix.mjs",
    "verify:render": "node --import ./scripts/loader-register.mjs scripts/e2e-print.mjs",
    "verify:all": "npm run typecheck && npm run verify:1d && npm run verify:qr && npm run verify:variables && npm run verify:fill && npm run verify:dpi && npm run verify:history && npm run verify:qrmatrix",
    "sample:template": "node scripts/make-sample-template.mjs",
    "sample:preview": "node --import ./scripts/loader-register.mjs scripts/preview-template.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.142",
    "@napi-rs/canvas": "^1.0.10",
    "@tauri-apps/cli": "^2.12.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.4"
  }
}
