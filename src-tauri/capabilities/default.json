{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "LabelDesk 主窗口权限",
  "windows": ["main", "quick"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
